{
  "name": "csp-builder",
  "version": "1.0.0",
  "description": "Typed Content-Security-Policy builder with directives, nonce/hash helpers, and header generation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "csp",
    "content-security-policy",
    "security",
    "headers",
    "web",
    "nonce"
  ],
  "author": "Ruzylo-cloud",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.0.0"
  }
}
